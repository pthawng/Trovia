DATABASE_URL="postgresql://trovia:trovia_password@localhost:5432/trovia_db?schema=public"
JWT_ACCESS_SECRET="your_access_secret_key"
JWT_REFRESH_SECRET="your_refresh_secret_key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:5173"
PORT=3001
NODE_ENV="development"
COOKIE_DOMAIN=""
COOKIE_SECURE="false"

# ── Mail Configuration ───────────────────────────────────────────────────────
# Providers:
#   Dev/Local:    Mailtrap (sandbox.smtp.mailtrap.io:587)
#   Gmail SMTP:   smtp.gmail.com:587  (use App Password)
#   Production:   Use Resend or SendGrid relay SMTP
#
# Leave MAIL_HOST empty to silently skip all emails (SKIPPED log entries created).
# MAIL_PASS is never logged or exposed via API.
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASS=
# MAIL_SECURE=false
# MAIL_FROM_NAME=Trovia
# MAIL_FROM_EMAIL=no-reply@trovia.vn

# ── Google OAuth Configuration ────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"
FRONTEND_AUTH_SUCCESS_REDIRECT_URL="http://localhost:5173/auth/callback"
FRONTEND_AUTH_ERROR_REDIRECT_URL="http://localhost:5173/login"
OAUTH_STATE_COOKIE_NAME="oauth_state"
COOKIE_SAME_SITE="lax"
